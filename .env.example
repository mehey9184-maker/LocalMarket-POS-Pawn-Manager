# ==========================================
# LocalMarket Server & Security Configuration
# ==========================================

# Supabase Free Tier Configuration (Client & Backend)
# Frontend uses only anon publishable key; never expose service_role in browser!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backblaze B2 Storage (Server-side ONLY; NEVER prefix with VITE_)
# Use bucket-restricted Application Keys
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=localmarket-item-photos
B2_BUCKET_ID=
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
